# MedBuddy Environment Variables Example
# Duplicate this file to .env.local and fill in your values.
# NEVER commit .env.local or any real secrets to Git.

# --- Public Configuration (Safe to expose in browser bundle) ---

# Canonical URL of the MedBuddy web application
NEXT_PUBLIC_SITE_URL=https://medbuddy-s7ven.vercel.app

# Supabase API Base URL (Project settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous API Key (Project settings -> API -> anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web Push VAPID Public Key (Uncompressed NIST P-256 base64url-encoded public key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Secret Configuration (Server-side / Edge Function / CI only - NEVER expose to client) ---

# Supabase Service Role Key (Project settings -> API -> service_role secret key)
# WARNING: Bypasses Row Level Security (RLS). Used only in admin scripts and secure tests.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push VAPID Private Key (32-byte NIST P-256 base64url-encoded private key)
# Used only by the Supabase Edge Function to sign Web Push payloads.
VAPID_PRIVATE_KEY=your-vapid-private-key

# Web Push Subject Contact (mailto: address for push service identification)
VAPID_SUBJECT=mailto:admin@example.com

# Cron Scheduler Secret (32-byte hex token)
# Used to authenticate pg_cron/pg_net HTTP requests to the send-notifications Edge Function.
CRON_SECRET=your-32-byte-hex-cron-secret

# Test User Flag (Set to 'true' only when running automated smoke tests on development stack)
ALLOW_TEST_USERS=false
