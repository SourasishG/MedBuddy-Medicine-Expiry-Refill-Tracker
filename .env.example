# ==============================================================================
# MedBuddy Environment Variables
# ==============================================================================
# Duplicate this file to .env.local and fill in your values.
# NEVER commit .env.local, database passwords, or real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CONFIGURATION (Safe to expose in client bundle - prefixed NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Public canonical URL of the deployed application (e.g. https://medbuddy-s7ven.vercel.app or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://medbuddy-s7ven.vercel.app

# Supabase API Base URL (Supabase Project Dashboard -> Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (Supabase Project Dashboard -> Settings -> API -> Project API Keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push VAPID Public Key (Uncompressed NIST P-256 base64url-encoded string from `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ------------------------------------------------------------------------------
# 2. SECRET CONFIGURATION (Server-side, Edge Function, and CI only - NEVER expose to browser)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Supabase Project Dashboard -> Settings -> API -> Project API Keys -> service_role)
# SECRET: Grants administrative database privileges, bypassing RLS. Used ONLY in backend scripts and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push VAPID Private Key (32-byte NIST P-256 base64url-encoded private key)
# SECRET: Used only by the Supabase Edge Function to cryptographically sign Web Push notification payloads.
VAPID_PRIVATE_KEY=your-vapid-private-key

# Web Push Subject Contact (mailto: address for push service identification per RFC 8292)
# SECRET / CONFIG: Stored in Edge Function secrets.
VAPID_SUBJECT=mailto:admin@example.com

# Cron Scheduler Secret (Long random string or 32-byte hex token)
# SECRET: Used to authenticate pg_cron/pg_net HTTP requests to the send-notifications Edge Function.
CRON_SECRET=your-32-byte-hex-cron-secret

# App State Cookie Secret (At least 32 characters)
# SECRET: Used by Next.js proxy/middleware to cryptographically sign and verify the short-lived `medbuddy_app_state` cookie.
# NEVER prefix with NEXT_PUBLIC_.
APP_COOKIE_SECRET=your-at-least-32-character-cookie-secret

# ------------------------------------------------------------------------------
# 3. CLI & DEVELOPMENT CONFIGURATION (Local developer machine only - NEVER in client bundle)
# ------------------------------------------------------------------------------

# Supabase Personal Access Token (Supabase Dashboard -> Account -> Access Tokens)
# SECRET: Required by Supabase CLI for `supabase link`, `supabase db push`, and `supabase functions deploy`.
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_access_token

# Supabase Project ID / Reference (Supabase Project Dashboard -> Settings -> General -> Reference ID)
# CONFIG: Used by automation scripts (`scripts/db-reset.mjs`, `scripts/db-types.mjs`, `scripts/db-test.mjs`).
SUPABASE_PROJECT_ID=your-project-ref

# Supabase Database Password (Set during project creation)
# SECRET: Used by direct psql connection in `scripts/db-test.mjs`.
SUPABASE_DB_PASSWORD=your-database-password

# Smoke Test Safety Guard (Set to 'true' only when running automated smoke tests on development project)
# CONFIG: Refuses execution on production unless explicitly set to 'true'.
ALLOW_TEST_USERS=false
